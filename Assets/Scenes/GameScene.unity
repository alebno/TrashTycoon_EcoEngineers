  m_Name: 
  m_EditorClassIdentifier: 
  promptFloatingText: {fileID: 1304369912}
  infoDisplayPanel: {fileID: 184384904}
  infoTextComponent: {fileID: 1605672330}
  educationalContent: "GU\xCDA DE SEPARACI\xD3N EN LA FUENTE:\r\n\u2022 Contenedor
    Azul: Pl\xE1sticos, botellas, cart\xF3n y metales limpios (Aprovechables).\r\n\u2022
    Contenedor Verde: C\xE1scaras de fruta y materia org\xE1nica para compostaje
    (Org\xE1nicos).\r\n\u2022 Contenedor Rojo: Pilas, bater\xEDas y componentes t\xF3xicos
    (Peligrosos).\r\n\xA1Separar correctamente en la fuente es la \xFAnica forma
    de evitar el gas metano y detener a Don Smog!"

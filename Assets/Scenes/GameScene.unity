--- !u!114 &268205701
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 268205699}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a785e9494b0e95c4eb3e7877ed36a4cd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  conversation:
  - speakerName: Nima (Mentora)
    nameColor: {r: 1, g: 0.52593994, b: 0, a: 0}
    text: "\xA1Mani, qu\xE9 bueno que llegas! La Corporaci\xF3n de Contaminaci\xF3n
      de Don Smog est\xE1 cerca. Si los residuos se acumulan sin clasificar, generar\xE1n
      gas metano y perderemos el campamento.\n<color=yellow>[Presiona E para continuar]</color> "
  - speakerName: "Mani (T\xFA)"
    nameColor: {r: 1, g: 0.93640804, b: 0, a: 0}
    text: "\xA1No lo permitir\xE9, Nima! Tengo puesto el equipo de bioseguridad.
      \xBFCu\xE1l es la primera instrucci\xF3n del entrenamiento?\n<color=yellow>[Presiona
      E para continuar]</color> "
  - speakerName: Nima (Mentora)
    nameColor: {r: 1, g: 0.5254902, b: 0, a: 0}
    text: "Hay 5 residuos cr\xEDticos dispersos en esta pista. Debes recolectarlos
      todos y consultar los carteles de informaci\xF3n para certificar tu inducci\xF3n.\n<color=yellow>[Presiona
      E para continuar]</color> "
  - speakerName: "Mani (T\xFA)"
    nameColor: {r: 0.9960785, g: 0.9333334, b: 0, a: 1}
    text: "\xA1Entendido! Recoger\xE9 los 5 residuos para cortar el suministro de
      metano y debilitar a Don Smog. \xA1Manos a la obra!\n<color=yellow>[Presiona
      E para continuar]</color> "
  dialoguePanel: {fileID: 14674559}
  nameText: {fileID: 477167128}
  contentText: {fileID: 1207612406}
  interactionPrompt: {fileID: 1818442517}
